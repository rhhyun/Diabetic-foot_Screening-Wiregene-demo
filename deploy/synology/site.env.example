# Copy this file to site.env on the NAS. Keep site.env out of Git.
# Only these site-specific values should differ between Wiregene services.

APP_NAME=wiregene-diabetic-foot
APP_DIR=/volume1/docker/diabetic-foot-screening/repo
APP_IMAGE=ghcr.io/rhhyun/diabetic-foot-screening-wiregene-demo:sha-REPLACE_WITH_FULL_COMMIT_SHA
APP_PORT=8300
HEALTH_URL=http://127.0.0.1:8300/api/ready
APP_ENV_FILE=/volume1/docker/diabetic-foot-screening/.env
REQUIRED_ENV_VARS="ADMIN_USERNAME ADMIN_PASSWORD SESSION_SECRET SUPABASE_URL SUPABASE_SERVICE_ROLE_KEY"
